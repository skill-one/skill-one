---
import { translations } from '../i18n/translations';
import { Scan, Sparkles, Rocket } from 'lucide-react';

interface Props {
  lang?: 'en' | 'zh';
}

const { lang = 'en' } = Astro.props;
const t = translations[lang].howItWorks;
const isZh = lang === 'zh';
---

<section id="how-it-works" class="py-24 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-semibold uppercase tracking-wider text-blue-400 font-mono">
        {t.eyebrow}
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mt-2 mb-4">
        {t.title}
      </h2>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        {t.subtitle}
      </p>
    </div>

    <!-- 3 Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      <!-- Step 1 -->
      <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-6 sm:p-8 backdrop-blur-md relative overflow-hidden flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="text-3xl font-extrabold text-blue-400 font-mono">
              {t.steps.step1.num}
            </span>
            <div class="size-10 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400">
              <Scan class="size-5" />
            </div>
          </div>

          <h3 class="text-lg font-bold text-white mb-2">
            {t.steps.step1.title}
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            {t.steps.step1.desc}
          </p>
        </div>

        <div class="mt-8 pt-4 border-t border-white/5 text-[10px] text-slate-400 font-mono">
          {isZh ? '自动扫描 80+ 款主流 Agent 配置目录' : 'Auto-scans 80+ agent configuration paths'}
        </div>
      </div>

      <!-- Step 2 -->
      <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-6 sm:p-8 backdrop-blur-md relative overflow-hidden flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="text-3xl font-extrabold text-teal-400 font-mono">
              {t.steps.step2.num}
            </span>
            <div class="size-10 rounded-xl bg-teal-500/10 border border-teal-500/20 flex items-center justify-center text-teal-400">
              <Sparkles class="size-5" />
            </div>
          </div>

          <h3 class="text-lg font-bold text-white mb-2">
            {t.steps.step2.title}
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            {t.steps.step2.desc}
          </p>
        </div>

        <div class="mt-8 pt-4 border-t border-white/5 text-[10px] text-slate-400 font-mono">
          {isZh ? '集中存储于 ~/.agents/skills 单一事实源' : 'Persisted into ~/.agents/skills central store'}
        </div>
      </div>

      <!-- Step 3 -->
      <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-6 sm:p-8 backdrop-blur-md relative overflow-hidden flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6">
            <span class="text-3xl font-extrabold text-purple-400 font-mono">
              {t.steps.step3.num}
            </span>
            <div class="size-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400">
              <Rocket class="size-5" />
            </div>
          </div>

          <h3 class="text-lg font-bold text-white mb-2">
            {t.steps.step3.title}
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            {t.steps.step3.desc}
          </p>
        </div>

        <div class="mt-8 pt-4 border-t border-white/5 text-[10px] text-slate-400 font-mono">
          {isZh ? '各智能体瞬时热加载，零编译等待' : 'Instant hot reload across all tools with 0ms delay'}
        </div>
      </div>
    </div>
  </div>
</section>

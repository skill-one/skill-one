---
import { translations } from '../i18n/translations';
import { Download, Apple, Monitor, Terminal, Shield, ExternalLink } from 'lucide-react';

interface Props {
  lang?: 'en' | 'zh';
}

const { lang = 'en' } = Astro.props;
const t = translations[lang].download;
const isZh = lang === 'zh';

const RELEASE_URL = 'https://github.com/skill-one/skill-one/releases/latest';
---

<section id="download" class="py-24 relative border-t border-white/[0.08] bg-[#070b14]/70">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-semibold uppercase tracking-wider text-blue-400 font-mono">
        {t.eyebrow}
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mt-2 mb-4">
        {t.title}
      </h2>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        {t.subtitle}
      </p>
    </div>

    <!-- Download Options Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <!-- macOS Card (Featured) -->
      <div class="rounded-2xl border border-blue-500/30 bg-slate-900/80 p-6 backdrop-blur-md flex flex-col justify-between relative shadow-xl shadow-blue-950/20">
        <div class="absolute -top-3 right-4 px-2.5 py-0.5 rounded-full bg-blue-500 text-white text-[10px] font-bold uppercase tracking-wider">
          Recommended
        </div>

        <div>
          <div class="size-11 rounded-xl bg-blue-500/15 border border-blue-500/30 flex items-center justify-center text-blue-400 mb-4">
            <Apple class="size-6" />
          </div>
          <h3 class="text-lg font-bold text-white mb-1">macOS</h3>
          <p class="text-xs text-slate-400 mb-6">macOS 12.0 (Monterey) or later</p>

          <div class="space-y-2.5">
            <a
              href={`${RELEASE_URL}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold transition-all shadow-md shadow-blue-600/20"
            >
              <div class="flex items-center gap-2">
                <Download class="size-3.5" />
                <span>{t.macArm}</span>
              </div>
              <span class="text-[10px] opacity-80 font-mono">.dmg</span>
            </a>

            <a
              href={`${RELEASE_URL}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-white/10 text-xs font-medium transition-colors"
            >
              <div class="flex items-center gap-2">
                <Download class="size-3.5" />
                <span>{t.macIntel}</span>
              </div>
              <span class="text-[10px] text-slate-400 font-mono">.dmg</span>
            </a>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-white/5 text-[10px] text-slate-400 font-mono text-center">
          Universal Binary Available
        </div>
      </div>

      <!-- Windows Card -->
      <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-6 backdrop-blur-md flex flex-col justify-between">
        <div>
          <div class="size-11 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center text-white mb-4">
            <Monitor class="size-6" />
          </div>
          <h3 class="text-lg font-bold text-white mb-1">Windows</h3>
          <p class="text-xs text-slate-400 mb-6">Windows 10 / 11 (64-bit)</p>

          <div class="space-y-2.5">
            <a
              href={`${RELEASE_URL}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-white/10 text-xs font-medium transition-colors"
            >
              <div class="flex items-center gap-2">
                <Download class="size-3.5" />
                <span>{t.windows}</span>
              </div>
              <span class="text-[10px] text-slate-400 font-mono">.exe / .msi</span>
            </a>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-white/5 text-[10px] text-slate-400 font-mono text-center">
          Native Windows Symlink Support
        </div>
      </div>

      <!-- Linux Card -->
      <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-6 backdrop-blur-md flex flex-col justify-between">
        <div>
          <div class="size-11 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center text-white mb-4">
            <Terminal class="size-6" />
          </div>
          <h3 class="text-lg font-bold text-white mb-1">Linux</h3>
          <p class="text-xs text-slate-400 mb-6">Ubuntu, Debian, Fedora, Arch</p>

          <div class="space-y-2.5">
            <a
              href={`${RELEASE_URL}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-white/10 text-xs font-medium transition-colors"
            >
              <div class="flex items-center gap-2">
                <Download class="size-3.5" />
                <span>{t.linux}</span>
              </div>
              <span class="text-[10px] text-slate-400 font-mono">.deb / AppImage</span>
            </a>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-white/5 text-[10px] text-slate-400 font-mono text-center">
          Standard Posix Symlink Architecture
        </div>
      </div>
    </div>

    <!-- Release Info & Guarantee -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 rounded-xl bg-slate-900/40 border border-white/10 text-xs text-slate-400">
      <div class="flex items-center gap-2">
        <Shield class="size-4 text-emerald-400" />
        <span>{t.openSourceBadge}</span>
      </div>

      <a
        href={RELEASE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 text-blue-400 hover:text-blue-300 font-medium transition-colors"
      >
        <span>{t.releaseNotes}</span>
        <ExternalLink class="size-3" />
      </a>
    </div>
  </div>
</section>

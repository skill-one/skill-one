---
import { translations } from '../i18n/translations';
import { XCircle, CheckCircle2, FolderSync, AlertTriangle, ShieldCheck } from 'lucide-react';

interface Props {
  lang?: 'en' | 'zh';
}

const { lang = 'en' } = Astro.props;
const t = translations[lang].problem;

const pains = [
  { icon: AlertTriangle, ...t.pains.duplication },
  { icon: AlertTriangle, ...t.pains.drift },
  { icon: AlertTriangle, ...t.pains.overhead },
];

const gains = [
  { icon: FolderSync, ...t.gains.singleSource },
  { icon: CheckCircle2, ...t.gains.instantSync },
  { icon: ShieldCheck, ...t.gains.zeroWaste },
];
---

<section id="problem-solution" class="py-16 relative border-t border-slate-200/80 dark:border-white/[0.08] transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <span class="text-xs font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 font-mono">
        {t.eyebrow}
      </span>
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight mt-2">
        {t.title}
      </h2>
    </div>

    <!-- Compact Comparison Strip -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
      {/* LEFT: Without Skill One */}
      <div class="rounded-2xl border border-rose-200/80 dark:border-red-500/20 bg-rose-50/40 dark:bg-slate-900/40 p-6 backdrop-blur-sm">
        <div class="flex items-center gap-2.5 mb-4">
          <XCircle class="size-4 text-rose-600 dark:text-red-400" />
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">{t.withoutTitle}</h3>
          <span class="text-[11px] text-rose-600 dark:text-red-400/80 font-medium">{t.withoutDesc}</span>
        </div>
        <ul class="space-y-3">
          {pains.map((pain) => (
            <li class="flex items-start gap-2.5 text-xs leading-relaxed">
              <pain.icon class="size-3.5 text-rose-500 dark:text-red-400 shrink-0 mt-0.5" />
              <span class="font-semibold text-slate-800 dark:text-slate-200 shrink-0">{pain.title}</span>
              <span class="text-slate-600 dark:text-slate-400">{pain.desc}</span>
            </li>
          ))}
        </ul>
      </div>

      {/* RIGHT: With Skill One */}
      <div class="rounded-2xl border border-emerald-200 dark:border-emerald-500/30 bg-emerald-50/50 dark:bg-slate-900/60 p-6 backdrop-blur-md">
        <div class="flex items-center gap-2.5 mb-4">
          <CheckCircle2 class="size-4 text-emerald-600 dark:text-emerald-400" />
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">{t.withTitle}</h3>
          <span class="text-[11px] text-emerald-700 dark:text-emerald-400/90 font-medium">{t.withDesc}</span>
        </div>
        <ul class="space-y-3">
          {gains.map((gain) => (
            <li class="flex items-start gap-2.5 text-xs leading-relaxed">
              <gain.icon class="size-3.5 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" />
              <span class="font-semibold text-emerald-950 dark:text-emerald-200 shrink-0">{gain.title}</span>
              <span class="text-slate-600 dark:text-slate-300">{gain.desc}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

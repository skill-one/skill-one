---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import { UniversalInstallShowcase } from '../components/UniversalInstallShowcase';
import BentoFeatures from '../components/BentoFeatures.astro';
import { AgentEcosystem } from '../components/AgentEcosystem';
import DownloadSection from '../components/DownloadSection.astro';
import FAQSection from '../components/FAQSection.astro';
---

<Layout lang="en">
  <Hero lang="en" />
  <ProblemSolution lang="en" />
  <UniversalInstallShowcase client:visible lang="en" />
  <BentoFeatures lang="en" />
  <AgentEcosystem client:visible lang="en" />
  <DownloadSection lang="en" />
  <FAQSection lang="en" />
</Layout>

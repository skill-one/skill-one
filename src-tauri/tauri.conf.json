{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Skill One",
  "version": "0.2.0",
  "identifier": "com.skillone.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Skill One",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1080,
        "height": 700,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "popover",
        "url": "popover.html",
        "title": "Skill One",
        "width": 320,
        "height": 400,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFOTBGRUJFMUUzQzg3MgpSV1J5eU9QaDZ3L3BEVUF4ZmhYazA3M1RTcW5TMEFQNmRZV0E0Q0k0eVplbjd1Y3VqSkVsV0pmdwo=",
      "endpoints": [
        "https://github.com/skill-one/skillone/releases/latest/download/latest.json"
      ]
    }
  }
}

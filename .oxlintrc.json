// oxlint rather than eslint: it is one fast binary with no plugin graph, and
// unused-code checks already belong to the compiler via noUnusedLocals /
// noUnusedParameters in tsconfig.app.json.
//
// Type-aware rules are a second pass, not a replacement: `pnpm lint` runs the
// syntax-only set, `pnpm exec oxlint --type-aware` adds the rules that need a
// type graph (no-floating-promises, await-thenable, unbound-method, ...). The
// backend for that pass is oxlint-tsgolint (tsgolint), which is a native
// implementation rather than typescript-eslint — so it does not inherit
// typescript-eslint's TypeScript-version support window and works on TS 7.
// Rules are switched off below where the flagged pattern is deliberate.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react-hooks", "import", "promise"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-shadow": "warn",
    "eslint/preserve-caught-error": "error",
    "unicorn/no-array-sort": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/globals": "off",
    "typescript/triple-slash-reference": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/require-post-message-target-origin": "off",
    "unicorn/consistent-function-scoping": "off",
    "eslint/no-underscore-dangle": "off",
    "vitest/require-mock-type-parameters": "off"
  },
  "ignorePatterns": ["dist", "coverage", "src-tauri"],
  "env": {
    "builtin": true
  }
}
